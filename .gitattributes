app/gui/vendor/** -text
# the launchers run only with their own system's line ends, whatever the checkout or a downloaded zip does
*.bat -text
*.sh text eol=lf
*.command text eol=lf
# pictures and film for the README: not part of the app, kept out of the testers' zip and of updates
docs/img/** export-ignore
docs/media/** export-ignore
# for working on the app, not for running it: kept out of the testers' zip and of updates too
tests export-ignore
.github export-ignore
.gitattributes export-ignore
update.example.json export-ignore
